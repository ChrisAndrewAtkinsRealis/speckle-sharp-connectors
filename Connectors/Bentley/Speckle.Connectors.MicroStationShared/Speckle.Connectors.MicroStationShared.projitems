    <Compile Include="$(MSBuildThisFileDirectory)HostApp\MicroStationInstanceUnpacker.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)HostApp\MicroStationTransformHelper.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Operations\Receive\MicroStationHostObjectBuilder.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Operations\Send\MicroStationRootObject.cs" />
