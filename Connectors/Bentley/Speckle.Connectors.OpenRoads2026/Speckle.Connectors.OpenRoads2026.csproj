<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OpenRoadsVersion>2026</OpenRoadsVersion>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);MICROSTATION;OPENROADS;OPENROADS2026</DefineConstants>
    <Configurations>Debug;Release;Local</Configurations>
    <AssemblyName>Speckle.Connectors.OpenRoads2026</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    OpenRoads Designer is built on MicroStation, so both the MicroStation base assemblies and the CifNET
    civil assemblies live in the OpenRoads install. Not redistributable / no public NuGet.
    Override OpenRoadsInstallDir if yours differs.
  -->
  <PropertyGroup Label="Bentley SDK">
    <OpenRoadsInstallDir Condition="'$(OpenRoadsInstallDir)' == ''">$(ProgramW6432)\Bentley\OpenRoads Designer CE\OpenRoadsDesigner\</OpenRoadsInstallDir>
  </PropertyGroup>

  <ItemGroup Label="MicroStation base API">
    <Reference Include="Bentley.MstnPlatformNET">
      <HintPath>$(OpenRoadsInstallDir)Bentley.MstnPlatformNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.DgnPlatformNET">
      <HintPath>$(OpenRoadsInstallDir)Bentley.DgnPlatformNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.GeometryNET">
      <HintPath>$(OpenRoadsInstallDir)Bentley.GeometryNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.GeometryNET.Structs">
      <HintPath>$(OpenRoadsInstallDir)Bentley.GeometryNET.Structs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.ECObjects">
      <HintPath>$(OpenRoadsInstallDir)Assemblies\ECFramework\Bentley.ECObjects.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.General.1.0">
      <HintPath>$(OpenRoadsInstallDir)Bentley.General.1.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="CifNET civil API">
    <Reference Include="Bentley.CifNET.SDK.4.0">
      <HintPath>$(OpenRoadsInstallDir)Bentley.CifNET.SDK.4.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.CifNET.GeometryModel.4.0">
      <HintPath>$(OpenRoadsInstallDir)Bentley.CifNET.GeometryModel.4.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.CifNET.LinearGeometry.4.0">
      <HintPath>$(OpenRoadsInstallDir)Bentley.CifNET.LinearGeometry.4.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Converters\Bentley\Speckle.Converters.OpenRoads2026\Speckle.Converters.OpenRoads2026.csproj" />
    <ProjectReference Include="..\..\..\DUI3\Speckle.Connectors.DUI.WebView\Speckle.Connectors.DUI.WebView.csproj" />
    <ProjectReference Include="..\..\..\Sdk\Speckle.Converters.Common\Speckle.Converters.Common.csproj" />
  </ItemGroup>

  <Import Project="..\Speckle.Connectors.MicroStationShared\Speckle.Connectors.MicroStationShared.projitems" Label="Shared" />
</Project>
