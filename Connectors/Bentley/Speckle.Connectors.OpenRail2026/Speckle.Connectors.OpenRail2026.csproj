<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <OpenRailVersion>2026</OpenRailVersion>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);MICROSTATION;OPENRAIL;OPENRAIL2026</DefineConstants>
    <Configurations>Debug;Release;Local</Configurations>
    <AssemblyName>Speckle.Connectors.OpenRail2026</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!--
    OpenRail Designer is built on MicroStation, so both the MicroStation base assemblies and the CifNET
    civil assemblies live in the OpenRail install. Not redistributable / no public NuGet.
    Override OpenRailInstallDir if yours differs.
  -->
  <PropertyGroup Label="Bentley SDK">
    <OpenRailInstallDir Condition="'$(OpenRailInstallDir)' == ''">$(ProgramW6432)\Bentley\OpenRail Designer 2026.00\OpenRailDesigner\</OpenRailInstallDir>
  </PropertyGroup>

  <ItemGroup Label="MicroStation base API">
    <Reference Include="Bentley.CifNET.GeometryModel.SDK.4.0">
      <HintPath>..\..\..\..\..\Program Files\Bentley\OpenRail Designer 2025.00\OpenRailDesigner\Cif\Bentley.CifNET.GeometryModel.SDK.4.0.dll</HintPath>
    </Reference>
    <Reference Include="Bentley.CifNET.GeometryModel.SDK.Edit.4.0">
      <HintPath>..\..\..\..\..\Program Files\Bentley\OpenRail Designer 2025.00\OpenRailDesigner\Cif\Bentley.CifNET.GeometryModel.SDK.Edit.4.0.dll</HintPath>
    </Reference>
    <Reference Include="Bentley.Civil.Rail.GeometryModel.SDKNet.Edit">
      <HintPath>..\..\..\..\..\Program Files\Bentley\OpenRail Designer 2025.00\OpenRailDesigner\OpenRail\Bentley.Civil.Rail.GeometryModel.SDKNet.Edit.dll</HintPath>
    </Reference>
    <Reference Include="ustation">
      <HintPath>$(OpenRailInstallDir)ustation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.DgnPlatformNET">
      <HintPath>$(OpenRailInstallDir)Bentley.DgnPlatformNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.GeometryNET">
      <HintPath>$(OpenRailInstallDir)Bentley.GeometryNET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.GeometryNET.Structs">
      <HintPath>$(OpenRailInstallDir)Bentley.GeometryNET.Structs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.ECObjects3">
      <HintPath>$(OpenRailInstallDir)Assemblies\ECFramework\Bentley.ECObjects3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.EC.Persistence3">
      <HintPath>$(OpenRailInstallDir)Assemblies\ECFramework\Bentley.EC.Persistence3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.ECObjects.MixedMode3">
      <HintPath>$(OpenRailInstallDir)Assemblies\ECFramework\Bentley.ECObjects.MixedMode3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.General.1.0">
      <HintPath>$(OpenRailInstallDir)Assemblies\ECFramework\Bentley.General.1.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Label="CifNET civil API">
    <Reference Include="Bentley.CifNET.SDK.4.0">
      <HintPath>$(OpenRailInstallDir)Cif\Bentley.CifNET.SDK.4.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bentley.CifNET.LinearGeometry.4.0">
      <HintPath>$(OpenRailInstallDir)Cif\Bentley.CifNET.LinearGeometry.4.0.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Converters\Bentley\Speckle.Converters.OpenRail2026\Speckle.Converters.OpenRail2026.csproj" />
    <ProjectReference Include="..\..\..\DUI3\Speckle.Connectors.DUI.WebView\Speckle.Connectors.DUI.WebView.csproj" />
    <ProjectReference Include="..\..\..\Sdk\Speckle.Converters.Common\Speckle.Converters.Common.csproj" />
  </ItemGroup>

  <Import Project="..\Speckle.Connectors.MicroStationShared\Speckle.Connectors.MicroStationShared.projitems" Label="Shared" />
</Project>
